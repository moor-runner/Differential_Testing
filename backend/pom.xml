<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-parent</artifactId><version>3.5.6</version><relativePath/></parent>
  <groupId>com.duipai</groupId><artifactId>duipai-backend</artifactId><version>1.0.6</version>
  <name>对拍工作台</name>
  <properties><java.version>21</java.version><project.build.sourceEncoding>UTF-8</project.build.sourceEncoding><duipai.build.directory>${project.basedir}/target</duipai.build.directory></properties>
  <dependencies>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-web</artifactId></dependency>
    <dependency><groupId>org.mybatis.spring.boot</groupId><artifactId>mybatis-spring-boot-starter</artifactId><version>3.0.5</version></dependency>
    <dependency><groupId>org.xerial</groupId><artifactId>sqlite-jdbc</artifactId><version>3.50.3.0</version></dependency>
    <dependency><groupId>net.java.dev.jna</groupId><artifactId>jna</artifactId><version>5.17.0</version></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-starter-test</artifactId><scope>test</scope></dependency>
  </dependencies>
  <build>
    <directory>${duipai.build.directory}</directory>
    <finalName>duipai-backend</finalName>
    <resources>
      <resource><directory>src/main/resources</directory></resource>
      <resource><directory>../frontend/dist</directory><targetPath>static</targetPath></resource>
    </resources>
    <plugins><plugin><groupId>org.springframework.boot</groupId><artifactId>spring-boot-maven-plugin</artifactId></plugin></plugins>
  </build>
  <profiles>
    <!-- macOS builds bundle a Swift helper that calls the Vision framework for local OCR (Xcode Command Line Tools required). -->
    <profile>
      <id>mac-ocr</id>
      <activation><os><family>mac</family></os></activation>
      <build>
        <plugins>
          <plugin>
            <groupId>org.codehaus.mojo</groupId><artifactId>exec-maven-plugin</artifactId>
            <executions>
              <execution>
                <id>compile-mac-ocr</id><phase>process-classes</phase><goals><goal>exec</goal></goals>
                <configuration>
                  <executable>swiftc</executable>
                  <arguments>
                    <argument>-O</argument>
                    <argument>-Xlinker</argument><argument>-sectcreate</argument>
                    <argument>-Xlinker</argument><argument>__TEXT</argument>
                    <argument>-Xlinker</argument><argument>__info_plist</argument>
                    <argument>-Xlinker</argument><argument>${project.basedir}/src/main/swift/Info.plist</argument>
                    <argument>-o</argument><argument>${project.build.outputDirectory}/ocr/mac-ocr</argument>
                    <argument>${project.basedir}/src/main/swift/mac-ocr.swift</argument>
                  </arguments>
                </configuration>
              </execution>
            </executions>
          </plugin>
        </plugins>
      </build>
    </profile>
  </profiles>
</project>
